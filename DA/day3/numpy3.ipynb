import numpy as np

n = 100_000_000
dice = np.random.randint(1, 7, size=(n, 2))
print(dice)
sums = np.sum(dice, axis=1)
print(sums)
values, counts = np.unique(sums, return_counts=True)
print(values)
print(counts)
prob_d = dict(zip(values, counts/n))
print(prob_d)

